#!/bin/bash

PACKAGE_NAME="SBNBackupNotifier"
SCRIPT="/var/packages/$PACKAGE_NAME/target/sbn-check.sh"

case "$1" in
    start)
        # Rendre le script executable
        chmod +x "$SCRIPT"
        # Ajouter la tache cron (toutes les heures)
        CRON_JOB="0 * * * * $SCRIPT"
        (crontab -l 2>/dev/null | grep -v "sbn-check"; echo "$CRON_JOB") | crontab -
        # Lancer un premier check immediatement
        $SCRIPT &
        exit 0
        ;;
    stop)
        crontab -l 2>/dev/null | grep -v "sbn-check" | crontab -
        exit 0
        ;;
    status)
        if crontab -l 2>/dev/null | grep -q "sbn-check"; then
            exit 0
        else
            exit 3
        fi
        ;;
esac
