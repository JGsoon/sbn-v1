#!/bin/bash

PACKAGE_NAME="SBNBackupNotifier"
SCRIPT="/var/packages/$PACKAGE_NAME/target/sbn-check.sh"
PID_FILE="/var/packages/$PACKAGE_NAME/target/sbn.pid"

case "$1" in
    start)
        chmod +x "$SCRIPT"
        CRON_JOB="0 * * * * $SCRIPT"
        (/usr/bin/crontab -l 2>/dev/null | grep -v "sbn-check"; echo "$CRON_JOB") | /usr/bin/crontab -
        echo "running" > "$PID_FILE"
        $SCRIPT &
        exit 0
        ;;
    stop)
        /usr/bin/crontab -l 2>/dev/null | grep -v "sbn-check" | /usr/bin/crontab -
        rm -f "$PID_FILE"
        exit 0
        ;;
    status)
        if [ -f "$PID_FILE" ]; then
            exit 0
        else
            exit 3
        fi
        ;;
esac
